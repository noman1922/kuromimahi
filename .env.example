# The Movie Database (TMDB) API Configuration
# Get your API key / Access Token at: https://www.themoviedb.org/settings/api

# Option 1: Secure Server Proxy (Recommended for development and Node proxy)
# Keeps credentials out of the client browser bundle.
TMDB_API_KEY=your_tmdb_api_key_v3_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_v4_here

# Option 2: Frontend-only Client Access (For static deployment e.g. Vercel/GitHub Pages)
# WARNING: VITE_ variables are embedded in the compiled JavaScript bundle and publicly visible.
# Do not commit real production secrets to version control.
VITE_TMDB_API_KEY=your_tmdb_api_key_v3_here
VITE_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_v4_here

# Playback Providers (Configurable Multi-Source Failover)
# Provider 1: VidLink Embed (Primary, fast zero-cost embed with cute-goth matching colors)
VITE_ENABLE_VIDLINK=true
VITE_VIDLINK_BASE_URL=https://vidlink.pro

# Provider 2: Zoryva Embed (Secondary failover, sandboxed multi-source player)
VITE_ENABLE_ZORYVA=true
VITE_ZORYVA_BASE_URL=https://zoryva.me

# Provider 3: VidSrc Embed (Tertiary failover, multi-provider embed)
VITE_ENABLE_VIDSRC=true
VITE_VIDSRC_BASE_URL=https://vidsrc.to

# Optional: Jellyfin Media Server (Personal vault for local/remote library)
# If left empty, Jellyfin is gracefully skipped and failover proceeds to free providers.
VITE_JELLYFIN_SERVER_URL=https://jellyfin.example.com
VITE_JELLYFIN_API_KEY=your_jellyfin_api_key_here
VITE_JELLYFIN_USER_ID=your_jellyfin_user_id_here
