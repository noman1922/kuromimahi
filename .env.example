# The Movie Database (TMDB) API Configuration
# Get your API key / Access Token at: https://www.themoviedb.org/settings/api

# Option 1: Secure Server Proxy (Recommended for development and Node proxy)
# Keeps credentials out of the client browser bundle.
TMDB_API_KEY=your_tmdb_api_key_v3_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_v4_here

# Option 2: Frontend-only Client Access (For static deployment e.g. Vercel/GitHub Pages)
# WARNING: VITE_ variables are embedded in the compiled JavaScript bundle and publicly visible.
# Do not commit real production secrets to version control.
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

